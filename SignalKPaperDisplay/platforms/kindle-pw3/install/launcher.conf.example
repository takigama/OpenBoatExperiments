# Copy this to /mnt/us/signalk/launcher.conf and edit. Read by startpaper.sh.

# Where your SignalK server is (host:port). Required.
SIGNALK_HOST=10.0.0.76:3001

# Upstart jobs to stop while the app owns the screen, and start again (in the
# reverse order) when the stock UI is handed back. The default is
# "framework lab126_gui": the framework is what draws the stock UI, and
# lab126_gui is what kept painting the stock clock over our header once the
# framework was gone. Stopping `pillow` as well made no difference on a
# Paperwhite 3. To go back to leaving the clock job running:
# STOP_JOBS="framework"
#
# paperdisplay also repaints its header every 10 s and just after each minute
# (-header-guard) as a backstop, in case something else draws there.

# Extra paperdisplay flags, e.g. a slower but smoother waveform:
# EXTRA_ARGS="-waveform GL16"
